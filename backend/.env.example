# Django Backend Environment Configuration
# Copia este archivo como ".env" (no lo subas a git) y ajusta los valores reales.
# SECRET_KEY es obligatoria: el backend no arranca sin ella. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Si DEBUG no se define, queda en False (modo produccion). Usa DEBUG=True solo en desarrollo.
SECRET_KEY=django-insecure-change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional for PostgreSQL; default uses SQLite)
# DB_NAME=patologia_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# Archivo SQLite (solo sin DB_NAME). npm run e2e (Cypress) usa e2e_db.sqlite3; en el uso normal no se define.
# SQLITE_NOMBRE=db.sqlite3

# CORS: orígenes del frontend permitidos para llamar a la API (separados por coma),
# también en desarrollo (decisión D-19). Desde cualquier otro origen, el navegador bloquea
# la respuesta (CORS) y la API responde 403 (config/origenes.py). No usar "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Documentación Swagger en /api/docs/ y esquema OpenAPI en /api/schema/ (decisión D-19).
# Si no se define, sigue a DEBUG: activa en desarrollo y apagada (404) en producción.
# DOCUMENTACION_API=True

# Proxies delante de Django (límites de peticiones por IP). 0 si Django recibe las
# peticiones directamente; 1 detrás de un Nginx que agrega X-Forwarded-For.
# Con 0 detrás de Nginx, todos los usuarios compartirían la IP del proxy.
NUM_PROXIES=0

# Nivel del registro de seguridad (inicios de sesión), que va a la consola:
# INFO registra los correctos y los fallidos; WARNING, solo los fallidos.
LOG_LEVEL=INFO

# Límite de peticiones por usuario con sesión (120/minute si no se define). Solo npm run e2e
# lo sube, porque Cypress va más rápido que una persona. El límite del login no se cambia aquí.
# LIMITE_PETICIONES_USUARIO=120/minute

# HTTPS / cookies seguras (activar en producción con certificado real)
SECURE_SSL_REDIRECT=False

# Encabezado del PDF de los informes (opcional). Sin estas variables se usa el
# encabezado de demostración. La dirección va en una sola línea, con la ciudad.
# Si LABORATORIO_TELEFONO está vacío, el PDF no imprime la línea del teléfono.
# Ejemplo ficticio (no uses datos de un laboratorio real sin autorización):
# LABORATORIO_NOMBRE=Laboratorio Ficticio de Anatomía Patológica
# LABORATORIO_DIRECCION=Calle Falsa 123, Santiago de Cali, Colombia
# LABORATORIO_TELEFONO=000 000 0000
